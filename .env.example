# Vercel build and runtime
ENABLE_EXPERIMENTAL_COREPACK=1
CONVEX_DEPLOY_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CONVEX_URL=
VITE_SITE_URL=http://localhost:9090

# Optional browser services and feature flags
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
VITE_CLERK_BILLING_ENABLED=false

# Local Convex CLI; production Convex variables are configured in Convex.
CONVEX_DEPLOYMENT=

# Also set CLERK_SECRET_KEY on the Convex deployment to refresh account emails
# at sign-in, including accounts created before the Clerk webhook was connected.

# Transactional email runtime (set these on the Convex deployment, not Vercel).
EMAIL_PROVIDER=console
APP_URL=http://localhost:9090
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=
RESEND_WEBHOOK_SECRET=
